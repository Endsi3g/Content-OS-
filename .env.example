# ── Database ─────────────────────────────────────────────────────────────────
# Required. Use PostgreSQL for production (Cloud Run + Cloud SQL).
DATABASE_URL="postgresql://user:password@localhost:5432/contentos_db"
# Dev alternative with local postgres via docker-compose:
# DATABASE_URL="postgresql://contentos:contentos@localhost:5432/contentos_db"

# ── Firebase Client (Vite frontend — must have VITE_ prefix) ─────────────────
# Get these values from Firebase Console → Project Settings → General → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# ── Firebase Admin SDK (server only — NEVER expose to frontend) ───────────────
# Get these from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Claude AI (server only) ───────────────────────────────────────────────────
# Server-side key for AI Coach endpoint. Get from Anthropic Console.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── Claude AI (frontend — AI Coach chat, file transcription) ─────────────────
# Client-side key for in-browser Claude calls. Restrict in production.
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-latest
VITE_ANTHROPIC_FAST_MODEL=claude-3-5-haiku-latest

# ── YouTube Integration ───────────────────────────────────────────────────────
# Required for YouTube OAuth and video import.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# ── Metricool Analytics ───────────────────────────────────────────────────────
# Get from Metricool dashboard → Integrations → API Key
VITE_METRICOOL_API_KEY=

# ── FreeFrame Integration ─────────────────────────────────────────────────────
# URL of the running FreeFrame instance.
# Local dev:  VITE_FREEFRAME_URL=http://localhost:3001
# Production: VITE_FREEFRAME_URL=https://review.yourdomain.com
VITE_FREEFRAME_URL=http://localhost:3001

# ── Admin Bootstrap ───────────────────────────────────────────────────────────
# Comma-separated emails that receive admin role on first login.
ADMIN_EMAILS=admin@yourdomain.com

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
